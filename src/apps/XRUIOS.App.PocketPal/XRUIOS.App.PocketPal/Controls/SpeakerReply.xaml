<UserControl x:Class="XRUIOS.App.PocketPal.Controls.SpeakerReply"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Margin="0,0,0,12">
    <!-- Speaker reply row. Blue stripe on the left, cropped speaker chip
         (assets/speaker.png) next to it, name + body on the right. -->
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="4"  />
            <ColumnDefinition Width="64" />
            <ColumnDefinition Width="*"  />
        </Grid.ColumnDefinitions>

        <Border Grid.Column="0" Background="#3E66B9" />

        <Image Grid.Column="1" Source="assets/speaker.png"
               Width="56" Height="56"
               Margin="6,4,6,4" />

        <StackPanel Grid.Column="2" Margin="6,0,4,4" VerticalAlignment="Top">
            <TextBlock x:Name="NameText"
                       Text=""
                       Foreground="White"
                       FontSize="22"
                       FontWeight="Light" />
            <TextBlock x:Name="BodyText"
                       Text=""
                       Foreground="#D3D3D3"
                       FontSize="14"
                       FontWeight="Light"
                       TextWrapping="Wrap"
                       LineHeight="20"
                       Margin="0,2,0,0" />
        </StackPanel>
    </Grid>
</UserControl>
