<Project Sdk="Microsoft.NET.Sdk">

  <!-- PocketPal OpenSilver app. The four-project template
       (App / Browser / Photino / Simulator) is stock; we add a project
       reference to the per-app Controls library and to XRUIOS.Apps.Shared
       (which is where the worker broker + widget chrome + integration holes
       live). Files listed explicitly per template convention. -->

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <EnableDefaultItems>false</EnableDefaultItems>
    <DefineSilverlight>true</DefineSilverlight>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="OpenSilver" Version="3.3.3" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\XRUIOS.Apps.Shared\XRUIOS.Apps.Shared.csproj" />
  </ItemGroup>

  <ItemGroup>
    <ApplicationDefinition Include="App.xaml">
      <Generator>MSBuild:Compile</Generator>
    </ApplicationDefinition>
    <Page Include="Controls\*.xaml">
      <Generator>MSBuild:Compile</Generator>
    </Page>
    <Page Include="MainPage.xaml">
      <Generator>MSBuild:Compile</Generator>
    </Page>
  </ItemGroup>

  <ItemGroup>
    <Compile Include="App.xaml.cs" />
    <Compile Include="Controls\*.cs" />
    <Compile Include="MainPage.xaml.cs" />
  </ItemGroup>

</Project>
