<Page x:Class="XRUIOS.App.PocketPal.MainPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:c="clr-namespace:XRUIOS.App.PocketPal.Controls"
      xmlns:s="clr-namespace:XRUIOS.Apps.Shared;assembly=XRUIOS.Apps.Shared"
      Background="#1F1F22">

    <Border CornerRadius="18" Background="#1F1F22" Padding="14">
        <Grid>
        <!-- COMPARE MODE: mockup overlay for 1:1 tuning. Delete when done. -->
        <Image Source="assets/mockup.png" Stretch="Uniform" Opacity="0.40" IsHitTestVisible="False" Grid.RowSpan="99" Grid.ColumnSpan="99" Canvas.ZIndex="1000" />
            <Grid.RowDefinitions>
                <!-- portrait sized proportional to the widget height -->
                <RowDefinition Height="45*" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*"    />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- Portrait plate (image goes here once the asset is checked in) -->
            <Border Grid.Row="0"
                    Background="#0E1013"
                    CornerRadius="14"
                    ClipToBounds="True">
                <c:PortraitBackdrop x:Name="Portrait" />
            </Border>

            <TextBlock Grid.Row="1"
                       x:Name="SpeakerName"
                       Text="Blank"
                       Foreground="White"
                       FontSize="32"
                       FontWeight="Light"
                       Margin="4,16,0,4" />

            <TextBlock Grid.Row="2"
                       x:Name="SpeakerLine"
                       Text="Right, so... the last team standing wins... not that I'm excited about it, but... I guess I have to care."
                       Foreground="#DADADA"
                       FontSize="18"
                       FontWeight="Light"
                       Margin="4,0,4,16"
                       TextWrapping="Wrap"
                       LineHeight="24" />

            <ScrollViewer Grid.Row="3" Margin="0,0,0,12">
                <ItemsControl x:Name="Replies" />
            </ScrollViewer>

            <Border Grid.Row="4"
                    Background="#FFFFFF"
                    CornerRadius="6"
                    Padding="12,10">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*"    />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="\U0001F50D" FontSize="16"
                               VerticalAlignment="Center" Margin="0,0,10,0" />
                    <TextBox Grid.Column="1"
                             x:Name="Input"
                             Text="Enter Text"
                             Background="Transparent"
                             BorderThickness="0"
                             Foreground="#888"
                             FontSize="16"
                             HorizontalContentAlignment="Center"
                             VerticalContentAlignment="Center" />
                </Grid>
            </Border>

            <s:SceneSwitchButton Grid.RowSpan="5" />
        </Grid>
    </Border>
</Page>
