<UserControl x:Class="XRUIOS.App.Gallery.Controls.AlbumCard"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Margin="8">
    <!-- Album / photo tile. Cover box supports either a tinted fill (colour)
         or a real image (assets/albumN.png) - the code-behind swaps them
         via a setter. Caption text is hidden on photo-only tiles. -->
    <StackPanel>
        <Grid>
            <Border Background="#22000000" CornerRadius="10" Margin="2,3,0,0" />
            <Border x:Name="Cover" Height="260" Background="#B0B0B0" CornerRadius="10"
                    ClipToBounds="True">
                <Image x:Name="CoverImage" Stretch="UniformToFill" Visibility="Collapsed" />
            </Border>
        </Grid>
        <TextBlock x:Name="TitleText"    Text="" FontSize="22" FontWeight="Light" Foreground="#111"
                   Margin="4,12,0,0" />
        <TextBlock x:Name="SubtitleText" Text="" FontSize="13" Foreground="#666"
                   Margin="4,2,0,0" />
    </StackPanel>
</UserControl>
