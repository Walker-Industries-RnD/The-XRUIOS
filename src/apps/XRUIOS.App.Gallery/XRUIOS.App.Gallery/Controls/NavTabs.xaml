<UserControl x:Class="XRUIOS.App.Gallery.Controls.NavTabs"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- Nav strip. Five text tabs on the left with a Bahnschrift body font;
         the underline bar sits under whichever one matches Selected (the
         code-behind toggles Visibility). "More" is a blue pill on the right,
         which uses Iceberg to look like a display CTA (matches the mockup). -->
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*"    />
            <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>

        <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Bottom">
            <StackPanel x:Name="AllTab"      Margin="0,0,36,0">
                <TextBlock Text="All"      FontSize="22" FontWeight="Light" Foreground="#111" Padding="0,8,0,6" />
                <Border    x:Name="AllUnderline"      Height="3" Background="#3E66B9" CornerRadius="2" Visibility="Collapsed" />
            </StackPanel>
            <StackPanel x:Name="AlbumsTab"   Margin="0,0,36,0">
                <TextBlock Text="Albums"   FontSize="22" FontWeight="Light" Foreground="#111" Padding="0,8,0,6" />
                <Border    x:Name="AlbumsUnderline"   Height="3" Background="#3E66B9" CornerRadius="2" Visibility="Collapsed" />
            </StackPanel>
            <StackPanel x:Name="ImagesTab"   Margin="0,0,36,0">
                <TextBlock Text="Images"   FontSize="22" FontWeight="Normal" Foreground="#111" Padding="0,8,0,6" />
                <Border    x:Name="ImagesUnderline"   Height="3" Background="#3E66B9" CornerRadius="2" Visibility="Collapsed" />
            </StackPanel>
            <StackPanel x:Name="SettingsTab" Margin="0,0,36,0">
                <TextBlock Text="Settings" FontSize="22" FontWeight="Light" Foreground="#111" Padding="0,8,0,6" />
                <Border    x:Name="SettingsUnderline" Height="3" Background="#3E66B9" CornerRadius="2" Visibility="Collapsed" />
            </StackPanel>
            <StackPanel x:Name="TrashTab">
                <TextBlock Text="Trash"    FontSize="22" FontWeight="Light" Foreground="#111" Padding="0,8,0,6" />
                <Border    x:Name="TrashUnderline"    Height="3" Background="#3E66B9" CornerRadius="2" Visibility="Collapsed" />
            </StackPanel>
        </StackPanel>

        <Grid Grid.Column="2" Margin="20,0,0,4">
            <Border Background="#22000000" CornerRadius="6" Margin="2,3,0,0" />
            <Button Content="More"
                    Background="#3E66B9" Foreground="White"
                    BorderThickness="0"
                    Padding="26,10"
                    FontFamily="Iceberg, Consolas, monospace"
                    FontSize="18" />
        </Grid>
    </Grid>
</UserControl>
