<Page x:Class="XRUIOS.App.Gallery.MainPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:c="clr-namespace:XRUIOS.App.Gallery.Controls"
      xmlns:s="clr-namespace:XRUIOS.Apps.Shared;assembly=XRUIOS.Apps.Shared"
      Background="White">

    <!-- Gallery - Albums scene. Top tabs strip (Images selected, More as
         blue pill), then large card grid of album covers. -->

    <Grid Margin="24">
        <!-- COMPARE MODE: mockup overlay for 1:1 tuning. Delete when done. -->
        <Image Source="assets/mockup.png" Stretch="Uniform" Opacity="0.40" IsHitTestVisible="False" Grid.RowSpan="99" Grid.ColumnSpan="99" Canvas.ZIndex="1000" />
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*"    />
        </Grid.RowDefinitions>

        <c:NavTabs Grid.Row="0" x:Name="Tabs" Selected="Images" />

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Margin="0,12,0,0">
            <c:AlbumGrid x:Name="Albums" Columns="4" />
        </ScrollViewer>

        <s:SceneSwitchButton Grid.RowSpan="2" />
    </Grid>
</Page>
