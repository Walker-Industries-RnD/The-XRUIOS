<Page x:Class="XRUIOS.App.WorldEvents.MainPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:c="clr-namespace:XRUIOS.App.WorldEvents.Controls"
      xmlns:s="clr-namespace:XRUIOS.Apps.Shared;assembly=XRUIOS.Apps.Shared"
      Background="#F0F0F0">

    <Grid Margin="20">
        <!-- COMPARE MODE: mockup overlay for 1:1 tuning. Delete when done. -->
        <Image Source="assets/mockup.png" Stretch="Uniform" Opacity="0.40" IsHitTestVisible="False" Grid.RowSpan="99" Grid.ColumnSpan="99" Canvas.ZIndex="1000" />
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="36*" />
            <ColumnDefinition Width="64*" />
        </Grid.ColumnDefinitions>

        <!-- HERO: cropped straight from World Events mockup (Group 2363.png) -->
        <Grid Grid.Column="0">
            <Border Background="#22000000" CornerRadius="10" Margin="2,3,0,0" />
            <Border CornerRadius="10" ClipToBounds="True" Background="#DDDDDD">
                <Image Source="assets/hero.png" Stretch="UniformToFill" />
            </Border>
        </Grid>

        <!-- RIGHT: header + search + event list -->
        <Grid Grid.Column="1" Margin="24,0,0,0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*"    />
            </Grid.RowDefinitions>

            <Grid Grid.Row="0" Margin="0,0,4,16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*"    />
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Column="0"
                           Text="XRUIOS Events"
                           FontFamily="Iceberg, Consolas, monospace"
                           FontSize="36"
                           Foreground="#111"
                           VerticalAlignment="Center" />

                <Grid Grid.Column="1" Margin="24,0,0,0">
                    <Border Background="#22000000" CornerRadius="10" Margin="2,3,0,0" />
                    <Border Background="White"
                            BorderBrush="#E0E0E0" BorderThickness="1"
                            CornerRadius="10"
                            Padding="16,10">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*"    />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Path Grid.Column="0" Fill="#111" Stretch="Uniform" Height="18"
                                  Data="M8,0 A8,8 0 1 1 7.9,16 A8,8 0 1 1 8,0 Z M13,13 L19,19 L21,17 L15,11 Z" />
                            <TextBox Grid.Column="1"
                                     Text="Enter Event Name Here"
                                     Background="Transparent"
                                     BorderThickness="0"
                                     Foreground="#888"
                                     FontFamily="Iceberg, Consolas, monospace"
                                     FontSize="16"
                                     Margin="12,0,10,0"
                                     VerticalContentAlignment="Center" />
                            <Border Grid.Column="2" Background="Black" CornerRadius="4" Padding="10,6">
                                <TextBlock Text="&#x25BC;" Foreground="White" FontSize="10"
                                           VerticalAlignment="Center" />
                            </Border>
                        </Grid>
                    </Border>
                </Grid>
            </Grid>

            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                <ItemsControl x:Name="Events" />
            </ScrollViewer>
        </Grid>

        <s:SceneSwitchButton Grid.ColumnSpan="2" />
    </Grid>
</Page>
