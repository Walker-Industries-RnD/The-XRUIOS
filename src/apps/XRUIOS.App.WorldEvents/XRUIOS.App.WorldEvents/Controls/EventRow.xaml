<UserControl x:Class="XRUIOS.App.WorldEvents.Controls.EventRow"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Margin="0,0,4,12">
    <!-- One row in the events list. Stacked title + origin, wrapped in a
         layered-border card so we get a subtle shadow. -->
    <Grid>
        <Border Background="#22000000" CornerRadius="10" Margin="2,3,0,0" />
        <Border Background="White" CornerRadius="10" Padding="26,18,26,20">
            <StackPanel>
                <TextBlock x:Name="TitleText"  Text="" FontSize="24" FontWeight="Light" Foreground="#111" />
                <TextBlock x:Name="OriginText" Text="" FontSize="13" FontWeight="Light" Foreground="#444" Margin="0,4,0,0" />
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
