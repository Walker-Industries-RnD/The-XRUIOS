<Page x:Class="XRUIOS.App.Power.MainPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:c="clr-namespace:XRUIOS.App.Power.Controls"
      xmlns:s="clr-namespace:XRUIOS.Apps.Shared;assembly=XRUIOS.Apps.Shared"
      Background="White">

    <!-- Landscape Power widget. Left: identity avatar + name + time above,
         angular green battery plate below. Right: big Iceberg "Power"
         wordmark and three rounded icon+label tiles (Power Off / Sleep /
         Log Out). -->

    <Grid>
        <!-- COMPARE MODE: mockup overlay for 1:1 tuning. Delete when done. -->
        <Image Source="assets/mockup.png" Stretch="Uniform" Opacity="0.40" IsHitTestVisible="False" Grid.RowSpan="99" Grid.ColumnSpan="99" Canvas.ZIndex="1000" />
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="45*" />
            <ColumnDefinition Width="55*" />
        </Grid.ColumnDefinitions>

        <Grid Grid.Column="0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*"    />
            </Grid.RowDefinitions>

            <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="24,24,0,0">
                <Image Source="assets/avatar.png" Width="72" Height="72" />
                <StackPanel Margin="16,4,0,0">
                    <TextBlock x:Name="UserLabel"
                               Text="WalkerDev"
                               Foreground="#111"
                               FontSize="30"
                               FontWeight="Light" />
                    <TextBlock x:Name="TimeLabel"
                               Text="00:00"
                               FontFamily="Iceberg, Consolas, monospace"
                               FontSize="20"
                               Foreground="#333" />
                </StackPanel>
            </StackPanel>

            <c:BatteryChip Grid.Row="1"
                           x:Name="Battery"
                           Percent="90"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center" />
        </Grid>

        <Grid Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="45*" />
                <RowDefinition Height="55*" />
            </Grid.RowDefinitions>

            <Viewbox Grid.Row="0" HorizontalAlignment="Right" Stretch="Uniform"
                     StretchDirection="DownOnly" Margin="0,24,44,10">
                <TextBlock Text="Power"
                           FontFamily="Iceberg, Consolas, monospace"
                           FontSize="130"
                           Foreground="#111" />
            </Viewbox>

            <Grid Grid.Row="1" Margin="30,0,30,26">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <c:PowerAction Grid.Column="0" Label="Power Off" Glyph="power" />
                <c:PowerAction Grid.Column="1" Label="Sleep"     Glyph="sleep" />
                <c:PowerAction Grid.Column="2" Label="Log Out"   Glyph="logout" />
            </Grid>
        </Grid>

        <s:SceneSwitchButton Grid.ColumnSpan="2" />
    </Grid>
</Page>
