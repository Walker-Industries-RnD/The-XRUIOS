<UserControl x:Class="XRUIOS.App.Power.Controls.BatteryChip"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- Angular green battery plate + stacked "%N" + "Charging" label. The
         Percent DP updates the big number. -->
    <Grid Width="260" Height="220">
        <Polygon Fill="#B3E78A" Points="20,8 240,30 220,180 0,210" />
        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
            <TextBlock x:Name="PercentText"
                       Text="%0"
                       FontSize="62" FontWeight="Light" Foreground="#111"
                       HorizontalAlignment="Center" />
            <TextBlock Text="Charging"
                       FontSize="16" Foreground="#222"
                       HorizontalAlignment="Center" Margin="0,-4,0,0" />
        </StackPanel>
    </Grid>
</UserControl>
