<Page x:Class="XRUIOS.App.Notifications.MainPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:c="clr-namespace:XRUIOS.App.Notifications.Controls"
      xmlns:s="clr-namespace:XRUIOS.Apps.Shared;assembly=XRUIOS.Apps.Shared"
      Background="#F2F2F2">

    <!-- Notifications feed. Star rows so the featured toast + the list body
         both scale with the window. -->

    <Grid>
        <!-- COMPARE MODE: mockup overlay for 1:1 tuning. Delete when done. -->
        <Image Source="assets/mockup.png" Stretch="Uniform" Opacity="0.40" IsHitTestVisible="False" Grid.RowSpan="99" Grid.ColumnSpan="99" Canvas.ZIndex="1000" />
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*"    />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Featured notification (rich card with hero image + body + actions) -->
        <c:FeaturedNotification Grid.Row="0"
                                x:Name="Featured"
                                Title="New Room.Sim Map Downloaded!"
                                Body="The Room.Sim map &quot;Downtown Apartment&quot; has successfully finished downloading! Get ready to explore your new virtual space and start customizing your experience in Room.Sim." />

        <ScrollViewer Grid.Row="1" Margin="12,12,12,0"
                      VerticalScrollBarVisibility="Auto">
            <ItemsControl x:Name="Feed" />
        </ScrollViewer>

        <TextBlock Grid.Row="2"
                   x:Name="MoreLabel"
                   Text="+12 Notifications"
                   Foreground="#111"
                   FontSize="18"
                   FontWeight="Light"
                   HorizontalAlignment="Center"
                   Margin="0,12,0,20" />

        <s:SceneSwitchButton Grid.RowSpan="3" />
    </Grid>
</Page>
