<UserControl x:Class="XRUIOS.App.Notifications.Controls.NotificationRow"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Margin="0,0,4,12">
    <!-- Notification card with the YuukOS logo cropped from the mockup. -->
    <Grid>
        <Border Background="#22000000" CornerRadius="12" Margin="2,3,0,0" />
        <Border Background="White" CornerRadius="12" Padding="22,18,22,20">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="86" />
                    <ColumnDefinition Width="*"  />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <Image Grid.Column="0" Source="assets/yuuk_logo.png"
                       Width="64" Height="64"
                       VerticalAlignment="Top" HorizontalAlignment="Left" />

                <StackPanel Grid.Column="1" Margin="4,0,0,0">
                    <TextBlock x:Name="SourceText" Text="" FontSize="13"
                               Foreground="#555" />
                    <TextBlock x:Name="TitleText"  Text="" FontSize="20"
                               FontWeight="Light" Foreground="#111"
                               TextWrapping="Wrap" Margin="0,4,0,6" />
                    <TextBlock x:Name="BodyText"   Text="" FontSize="13"
                               FontWeight="Light" Foreground="#444"
                               TextWrapping="Wrap" LineHeight="19" />
                </StackPanel>

                <TextBlock Grid.Column="2" x:Name="TimeText"
                           Text="" FontSize="13" Foreground="#555"
                           VerticalAlignment="Top" Margin="16,4,0,0" />
            </Grid>
        </Border>
    </Grid>
</UserControl>
