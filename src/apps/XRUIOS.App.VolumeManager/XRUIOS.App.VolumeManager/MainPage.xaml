<Page x:Class="XRUIOS.App.VolumeManager.MainPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:c="clr-namespace:XRUIOS.App.VolumeManager.Controls"
      xmlns:s="clr-namespace:XRUIOS.Apps.Shared;assembly=XRUIOS.Apps.Shared"
      Background="#F0F0F0">

    <!-- App Volumes Manager widget. Rounded white card with layered shadow;
         header text uses Bahnschrift Light per mockup; slider rows scroll. -->
    <Grid Margin="14">
        <!-- COMPARE MODE: mockup overlay for 1:1 tuning. Delete when done. -->
        <Image Source="assets/mockup.png" Stretch="Uniform" Opacity="0.40" IsHitTestVisible="False" Grid.RowSpan="99" Grid.ColumnSpan="99" Canvas.ZIndex="1000" />
        <Border Background="#22000000" CornerRadius="14" Margin="2,3,0,0" />
        <Border Background="White" CornerRadius="14">
            <Grid Margin="28,26,18,22">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*"    />
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0"
                           Text="App Volumes Manager"
                           Foreground="#111"
                           FontSize="28"
                           FontWeight="Light"
                           Margin="0,0,0,20" />

                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                    <ItemsControl x:Name="Channels" />
                </ScrollViewer>
            </Grid>
        </Border>

        <s:SceneSwitchButton />
    </Grid>
</Page>
