<UserControl x:Class="XRUIOS.App.VolumeManager.Controls.ChannelRow"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Margin="0,0,6,14">
    <!-- One volume channel row: image thumb (assets/channel_icon.png,
         cropped from the mockup), app name, slider, numeric value. -->
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="80" />
            <ColumnDefinition Width="2*" MinWidth="60" />
            <ColumnDefinition Width="4*" MinWidth="80" />
            <ColumnDefinition Width="48" />
        </Grid.ColumnDefinitions>

        <Border Grid.Column="0"
                Width="60" Height="60"
                Background="White"
                BorderBrush="#E0E0E0"
                BorderThickness="1"
                CornerRadius="6"
                VerticalAlignment="Center"
                ClipToBounds="True">
            <Image Source="assets/channel_icon.png" Stretch="UniformToFill" />
        </Border>

        <TextBlock Grid.Column="1" x:Name="AppText" Text=""
                   FontSize="18" FontWeight="Light" Foreground="#111"
                   VerticalAlignment="Center" TextTrimming="CharacterEllipsis"
                   Margin="4,0,12,0" />

        <Slider Grid.Column="2" x:Name="LevelSlider" Minimum="0" Maximum="100"
                VerticalAlignment="Center" Margin="0,0,12,0"
                ValueChanged="LevelSlider_ValueChanged" />

        <TextBlock Grid.Column="3" x:Name="ValueText"
                   Text="0" FontSize="22" FontWeight="Light" Foreground="#111"
                   VerticalAlignment="Center" HorizontalAlignment="Right" />
    </Grid>
</UserControl>
