<Page x:Class="XRUIOS.App.ThemeEditor.MainPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:c="clr-namespace:XRUIOS.App.ThemeEditor.Controls"
      xmlns:s="clr-namespace:XRUIOS.Apps.Shared;assembly=XRUIOS.Apps.Shared"
      Background="White">

    <!-- Theme Editor - landing scene. Left half is a character illustration
         plate (empty until the real art is added) with three floating pixel
         icon chips. Right half has the ".Editor" title, a big preview card
         of the current theme, and an "Explore" button. Far right column is
         a vertical wordmark. -->

    <Grid Margin="20">
        <!-- COMPARE MODE: mockup overlay for 1:1 tuning. Delete when done. -->
        <Image Source="assets/mockup.png" Stretch="Uniform" Opacity="0.40" IsHitTestVisible="False" Grid.RowSpan="99" Grid.ColumnSpan="99" Canvas.ZIndex="1000" />
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="46*" />
            <ColumnDefinition Width="10*" />
            <ColumnDefinition Width="42*" />
            <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>

        <!-- LEFT hero -->
        <Border Grid.Column="0" CornerRadius="6" ClipToBounds="True">
            <c:HeroPlate />
        </Border>

        <!-- Floating pixel icon chips - middle column -->
        <StackPanel Grid.Column="1" HorizontalAlignment="Center" VerticalAlignment="Center">
            <c:PixelIconChip Glyph="ÃƒÆ’Ã‚Â°Ãƒâ€¦Ã‚Â¸Ãƒâ€šÃ‚Â§Ãƒâ€šÃ‚Â¢" Tint="#C89A4A" Margin="0,0,0,140" />
            <c:PixelIconChip Glyph="ÃƒÆ’Ã‚Â°Ãƒâ€¦Ã‚Â¸ÃƒÂ¢Ã¢â€šÂ¬Ã¢â€žÂ¢Ãƒâ€šÃ‚Â§" Tint="#3EE0B4" Margin="0,0,0,140" />
            <c:PixelIconChip Glyph="ÃƒÆ’Ã‚Â°Ãƒâ€¦Ã‚Â¸Ãƒâ€šÃ‚Â§Ãƒâ€šÃ‚Âª" Tint="#B8E23E" />
        </StackPanel>

        <!-- RIGHT: title + hero card + Explore -->
        <Grid Grid.Column="2" Margin="20,0,20,0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*"    />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <StackPanel Grid.Row="0" Margin="0,10,0,20" HorizontalAlignment="Right">
                <TextBlock Text=".Editor"
                           Foreground="#111"
                           FontSize="72"
                           FontWeight="Light"
                           HorizontalAlignment="Right" />
                <TextBlock Text="XRUIOS Theme Editor"
                           Foreground="#333"
                           FontSize="20"
                           HorizontalAlignment="Right"
                           Margin="0,-8,0,0" />
            </StackPanel>

            <Border Grid.Row="1"
                    Background="White"
                    CornerRadius="12"
                    BorderBrush="#E8E8E8"
                    BorderThickness="1"
                    ClipToBounds="True">
                <c:ThemePreview />
            </Border>

            <Button Grid.Row="2"
                    Content="Explore"
                    Background="White"
                    Foreground="#111"
                    BorderBrush="#DDD"
                    BorderThickness="1"
                    Padding="18,14"
                    Margin="0,20,0,10"
                    FontSize="20"
                    HorizontalAlignment="Stretch" />
        </Grid>

        <!-- Vertical wordmark -->
        <TextBlock Grid.Column="3"
                   Text="XRUIOS Theme Editor"
                   Foreground="#111"
                   FontSize="14"
                   Margin="12,0,0,0"
                   VerticalAlignment="Bottom">
            <TextBlock.RenderTransform>
                <RotateTransform Angle="-90" CenterX="0" CenterY="0" />
            </TextBlock.RenderTransform>
        </TextBlock>

        <s:SceneSwitchButton Grid.ColumnSpan="4" />
    </Grid>
</Page>
