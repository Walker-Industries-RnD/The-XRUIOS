<UserControl x:Class="XRUIOS.App.AppLauncher.Controls.AppTile"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Margin="6,6,6,26"
             HorizontalAlignment="Center">
    <!-- One app tile: rounded icon plate + 2-line name below. Tint colour
         is set by the code-behind (or an Image swap once real cover art is
         wired up). -->
    <StackPanel HorizontalAlignment="Center">
        <Border x:Name="IconChip"
                Width="88" Height="88"
                Background="#111"
                CornerRadius="16" />
        <TextBlock x:Name="NameText"
                   Text=""
                   FontSize="14"
                   Foreground="#111"
                   HorizontalAlignment="Center"
                   TextAlignment="Center"
                   TextWrapping="Wrap"
                   Margin="0,8,0,0"
                   MaxWidth="100"
                   LineHeight="16" />
    </StackPanel>
</UserControl>
