<Page x:Class="XRUIOS.App.AppLauncher.MainPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:c="clr-namespace:XRUIOS.App.AppLauncher.Controls"
      xmlns:s="clr-namespace:XRUIOS.Apps.Shared;assembly=XRUIOS.Apps.Shared"
      Background="#F0F0F0">

    <!-- Left: tall poster card (real cover art asset drops in over the
         placeholder gradient). Right: white rounded panel with 5-col icon
         grid. Both panels use layered borders for a soft shadow. -->

    <Grid Margin="18">
        <!-- COMPARE MODE: mockup overlay for 1:1 tuning. Delete when done. -->
        <Image Source="assets/mockup.png" Stretch="Uniform" Opacity="0.40" IsHitTestVisible="False" Grid.RowSpan="99" Grid.ColumnSpan="99" Canvas.ZIndex="1000" />
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="28*" />
            <ColumnDefinition Width="72*" />
        </Grid.ColumnDefinitions>

        <Grid Grid.Column="0" Margin="0,0,18,0">
            <Border Background="#22000000" CornerRadius="14" Margin="2,3,0,0" />
            <Border Background="White" CornerRadius="14">
                <c:PortraitFrame />
            </Border>
        </Grid>

        <Grid Grid.Column="1">
            <Border Background="#22000000" CornerRadius="14" Margin="2,3,0,0" />
            <Border Background="White" CornerRadius="14">
                <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="34,36,20,28">
                    <c:AppTileGrid x:Name="Tiles" Columns="5" />
                </ScrollViewer>
            </Border>
        </Grid>

        <s:SceneSwitchButton Grid.ColumnSpan="2" />
    </Grid>
</Page>
