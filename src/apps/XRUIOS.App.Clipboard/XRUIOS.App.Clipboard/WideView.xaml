<Page x:Class="XRUIOS.App.Clipboard.WideView"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:c="clr-namespace:XRUIOS.App.Clipboard.Controls"
      xmlns:s="clr-namespace:XRUIOS.Apps.Shared;assembly=XRUIOS.Apps.Shared"
      Background="#EDEDED">

    <!-- Wide clipboard variant (Group 1567 in the mockup folder). Three panels
         drill from groups ÃƒÆ’Ã‚Â¢ÃƒÂ¢Ã¢â€šÂ¬Ã‚Â ÃƒÂ¢Ã¢â€šÂ¬Ã¢â€žÂ¢ group contents ÃƒÆ’Ã‚Â¢ÃƒÂ¢Ã¢â€šÂ¬Ã‚Â ÃƒÂ¢Ã¢â€šÂ¬Ã¢â€žÂ¢ item covers. Fully responsive:
         each panel is a star column so re-sizing balances the split. -->

    <Grid>
        <!-- COMPARE MODE: mockup overlay for 1:1 tuning. Delete when done. -->
        <Image Source="assets/wide_mockup.png" Stretch="Uniform" Opacity="0.40" IsHitTestVisible="False" Grid.RowSpan="99" Grid.ColumnSpan="99" Canvas.ZIndex="1000" />
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="22*" />
            <ColumnDefinition Width="24*" />
            <ColumnDefinition Width="54*" />
        </Grid.ColumnDefinitions>

        <!-- LEFT: groups -->
        <c:ClipPanel Grid.Column="0"
                     x:Name="GroupsPanel"
                     Title="Clipboard Groups"
                     CornerNote="Edit and X Button"
                     AccentBar="True" />

        <!-- MIDDLE: group titles -->
        <c:ClipPanel Grid.Column="1"
                     x:Name="TitlesPanel"
                     Title="Clipboard Group Title" />

        <!-- RIGHT: item covers -->
        <c:ClipPanel Grid.Column="2"
                     x:Name="CoversPanel"
                     Title="Clipboard Group Title" />

        <s:SceneSwitchButton Grid.ColumnSpan="3" />
    </Grid>
</Page>
