<UserControl x:Class="XRUIOS.App.Clipboard.Controls.CoverTile"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Margin="6">
    <StackPanel>
        <Border x:Name="Cover" Height="120" CornerRadius="2" Background="#B0B0B0" />
        <TextBlock x:Name="CaptionText" Text=""
                   FontSize="12" Foreground="#111"
                   HorizontalAlignment="Center"
                   Margin="0,6,0,6"
                   TextTrimming="CharacterEllipsis" />
    </StackPanel>
</UserControl>
