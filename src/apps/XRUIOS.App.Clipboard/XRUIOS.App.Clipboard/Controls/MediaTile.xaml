<UserControl x:Class="XRUIOS.App.Clipboard.Controls.MediaTile"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- One thumbnail block in the media wall. Height is set by the code-
         behind constructor from the mockup's design height; MediaWrap
         packs these into columns. -->
    <Border x:Name="TileFill" CornerRadius="2" Background="#B0B0B0" />
</UserControl>
