<UserControl x:Class="XRUIOS.App.Clipboard.Controls.GroupCard"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Margin="0,0,0,6">
    <!-- Left-panel row: pink thumb + name/subtitle. -->
    <Grid Background="#F6F6F6">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="56" />
            <ColumnDefinition Width="*"  />
        </Grid.ColumnDefinitions>
        <Border Grid.Column="0"
                Width="40" Height="40"
                Background="#E5B2AB"
                Margin="8"
                CornerRadius="2" />
        <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="2,0,8,0">
            <TextBlock x:Name="NameText"     Text="" FontSize="14" Foreground="#111" />
            <TextBlock x:Name="SubtitleText" Text="" FontSize="11" Foreground="#888" Margin="0,2,0,0" />
        </StackPanel>
    </Grid>
</UserControl>
