<UserControl x:Class="XRUIOS.App.Clipboard.Controls.ClipPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- One of the three vertical panels in the wide clipboard view. Header
         row + optional yellow right-edge stripe + a scrolling body + a
         search footer. Body swaps between the vertical list and the 4-col
         cover grid via AddCard/AddCover from code-behind. -->
    <Border Background="White" Margin="10" CornerRadius="4">
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="6" />
            </Grid.ColumnDefinitions>

            <Grid Grid.Column="0" Margin="16,14,16,14">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*"    />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <Grid Grid.Row="0" Margin="0,0,0,8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" x:Name="TitleTextBlock"
                               Text=""
                               FontSize="15"
                               Foreground="#111"
                               VerticalAlignment="Center" />
                    <TextBlock Grid.Column="1" x:Name="CornerTextBlock"
                               Text=""
                               FontSize="11"
                               Foreground="#888"
                               VerticalAlignment="Center" />
                </Grid>

                <ScrollViewer Grid.Row="1"
                              VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled">
                    <Grid>
                        <StackPanel x:Name="ListHost" />
                        <Grid       x:Name="CoverHost" Visibility="Collapsed" />
                    </Grid>
                </ScrollViewer>

                <Grid Grid.Row="2" Margin="0,10,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="36" />
                    </Grid.ColumnDefinitions>
                    <Grid Grid.Column="0">
                        <TextBox Background="White"
                                 BorderBrush="#DDD"
                                 BorderThickness="1"
                                 Padding="28,6,8,6"
                                 FontSize="11" />
                        <TextBlock Text="&#x1F50D;" FontSize="12"
                                   Margin="10,0,0,0"
                                   VerticalAlignment="Center"
                                   IsHitTestVisible="False" />
                    </Grid>
                    <Button Grid.Column="1"
                            Content="&#x25BC;"
                            Background="Black"
                            Foreground="White"
                            BorderThickness="0"
                            Margin="4,0,0,0"
                            FontSize="10" />
                </Grid>
            </Grid>

            <Border Grid.Column="1" x:Name="AccentStripe"
                    Background="#F0DA1F"
                    Visibility="Collapsed" />
        </Grid>
    </Border>
</UserControl>
