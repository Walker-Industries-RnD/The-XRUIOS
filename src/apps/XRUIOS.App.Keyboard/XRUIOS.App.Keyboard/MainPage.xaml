<Page x:Class="XRUIOS.App.Keyboard.MainPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:c="clr-namespace:XRUIOS.App.Keyboard.Controls"
      xmlns:s="clr-namespace:XRUIOS.Apps.Shared;assembly=XRUIOS.Apps.Shared"
      Background="White">

    <!-- On-screen keyboard: suggestion strip on top with a back-arrow chip
         and pill word-suggestions, then a 5-row key grid. Whole thing lives
         in a rounded panel; grid keys are equal-width stars so the layout
         re-flows as the widget resizes. -->

    <Border Background="White" CornerRadius="12" Margin="0">
        <Grid Margin="18">
        <!-- COMPARE MODE: mockup overlay for 1:1 tuning. Delete when done. -->
        <Image Source="assets/mockup.png" Stretch="Uniform" Opacity="0.40" IsHitTestVisible="False" Grid.RowSpan="99" Grid.ColumnSpan="99" Canvas.ZIndex="1000" />
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*"    />
            </Grid.RowDefinitions>

            <TextBlock Grid.Row="0"
                       x:Name="EnteredText"
                       Text="Entered Text"
                       Foreground="#111"
                       FontSize="20"
                       Margin="6,2,6,14"
                       HorizontalAlignment="Right" />

            <!-- Suggestion strip -->
            <Grid Grid.Row="1" Margin="0,0,0,12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Button Grid.Column="0"
                        Content="&lt;"
                        Background="#DDDDDD"
                        Foreground="#111"
                        BorderThickness="0"
                        Padding="14,8"
                        Margin="0,0,10,0"
                        FontSize="18" />
                <c:SuggestionPill Grid.Column="1" Word="Word Suggestion" />
                <c:SuggestionPill Grid.Column="2" Word="Word Suggestion" />
                <c:SuggestionPill Grid.Column="3" Word="Word Suggestion" />
                <c:SuggestionPill Grid.Column="4" Word="Word Suggestion" />
            </Grid>

            <c:KeyBoardBed Grid.Row="2" x:Name="Bed" />

            <s:SceneSwitchButton Grid.RowSpan="3" />
        </Grid>
    </Border>
</Page>
