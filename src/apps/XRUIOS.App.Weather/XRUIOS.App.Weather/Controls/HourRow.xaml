<UserControl x:Class="XRUIOS.App.Weather.Controls.HourRow"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Margin="0,0,4,10">
    <!-- One hourly forecast row. Layered white borders build a subtle
         shadow (OpenSilver-friendly) around the card; content grid keeps
         cloud + condition (star) + hour + temp aligned. Cloud icon is a
         Path so it renders as a solid black glyph rather than an emoji. -->
    <Grid>
        <!-- Shadow layer: slightly darker, offset down/right -->
        <Border Background="#22000000" CornerRadius="10" Margin="2,3,0,0" />
        <Border Background="White"     CornerRadius="10" Padding="26,14,26,14">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="60" />
                    <ColumnDefinition Width="*"  />
                    <ColumnDefinition Width="70" />
                    <ColumnDefinition Width="82" />
                </Grid.ColumnDefinitions>

                <!-- Cloud glyph (solid black Path, sized ~44px tall to match reference) -->
                <Path Grid.Column="0"
                      Fill="#0A0A0A"
                      Stretch="Uniform"
                      Height="42"
                      HorizontalAlignment="Left"
                      VerticalAlignment="Center"
                      Data="M20,50 C10,50 5,42 5,35 C5,26 12,21 19,22 C22,10 33,5 42,10 C48,3 60,3 65,12 C74,10 82,17 82,25 C90,26 92,34 90,40 C89,47 82,50 75,50 Z" />

                <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="16,0,0,0">
                    <TextBlock x:Name="ConditionText" Text=""
                               FontSize="26" FontWeight="Light" Foreground="#111" />
                    <TextBlock x:Name="PrecipText"    Text=""
                               FontSize="12" FontWeight="Light" Foreground="#333"
                               Margin="0,2,0,0" />
                </StackPanel>

                <TextBlock Grid.Column="2" x:Name="HourText"
                           Text=""
                           FontFamily="Iceberg, Consolas, monospace"
                           FontSize="22"
                           Foreground="#111"
                           VerticalAlignment="Center"
                           HorizontalAlignment="Right" />

                <StackPanel Grid.Column="3" Orientation="Horizontal"
                            VerticalAlignment="Center" HorizontalAlignment="Right">
                    <TextBlock x:Name="TempText" Text=""
                               FontFamily="Iceberg, Consolas, monospace"
                               FontSize="42"
                               Foreground="#111" />
                    <TextBlock Text="&#xB0;C" FontSize="14"
                               FontFamily="Iceberg, Consolas, monospace"
                               Foreground="#111"
                               VerticalAlignment="Top" Margin="2,6,0,0" />
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</UserControl>
