<Page x:Class="XRUIOS.App.Weather.MainPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:c="clr-namespace:XRUIOS.App.Weather.Controls"
      xmlns:s="clr-namespace:XRUIOS.Apps.Shared;assembly=XRUIOS.Apps.Shared"
      Background="#F0F0F0">

    <!-- Weather. Left hero card (watercolor sky + character placeholder,
         big temperature top-right). Right side: huge digital time + city,
         then the scrolling hourly forecast, and two "Edit Graphics" /
         "View Elsewhere" pill buttons at the bottom. -->

    <Grid Margin="20">
        <!-- COMPARE MODE: mockup overlay for 1:1 tuning. Delete when done. -->
        <Image Source="assets/mockup.png" Stretch="Uniform" Opacity="0.40" IsHitTestVisible="False" Grid.RowSpan="99" Grid.ColumnSpan="99" Canvas.ZIndex="1000" />
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="60*" />
            <ColumnDefinition Width="40*" />
        </Grid.ColumnDefinitions>

        <!-- HERO -->
        <Grid Grid.Column="0">
            <Border Background="#22000000" CornerRadius="14" Margin="2,3,0,0" />
            <Border CornerRadius="14" ClipToBounds="True" Background="#C7DFF0">
                <Grid>
                    <c:HeroSky />

                    <Grid Margin="0,30,42,0" VerticalAlignment="Top" HorizontalAlignment="Right">
                        <StackPanel HorizontalAlignment="Right">
                            <TextBlock x:Name="TempText"
                                       Text="32&#xB0;C"
                                       FontFamily="Iceberg, Consolas, monospace"
                                       FontSize="72"
                                       Foreground="#111"
                                       HorizontalAlignment="Right" />
                            <TextBlock x:Name="FeelsText"
                                       Text="Feels like 302&#xB0;C"
                                       Foreground="#222"
                                       FontSize="18"
                                       FontWeight="Light"
                                       HorizontalAlignment="Right"
                                       Margin="0,-4,0,0" />
                        </StackPanel>
                    </Grid>
                </Grid>
            </Border>
        </Grid>

        <!-- RIGHT -->
        <Grid Grid.Column="1" Margin="24,0,0,0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*"    />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <StackPanel Grid.Row="0" Margin="6,10,6,20">
                <TextBlock x:Name="TimeText"
                           Text="11:16AM"
                           FontFamily="Iceberg, Consolas, monospace"
                           FontSize="80"
                           Foreground="#111" />
                <TextBlock x:Name="LocationText"
                           Text="Town Of Beginnings, Aincrad"
                           Foreground="#333"
                           FontSize="18"
                           FontWeight="Light"
                           Margin="0,-6,0,0" />
            </StackPanel>

            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled">
                <ItemsControl x:Name="Hours" Margin="0,0,4,0" />
            </ScrollViewer>

            <Grid Grid.Row="2" Margin="0,14,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Grid Grid.Column="0" Margin="0,0,6,0">
                    <Border Background="#22000000" CornerRadius="14" Margin="2,3,0,0" />
                    <Button Content="Edit Graphics"
                            Background="White" Foreground="#111"
                            BorderBrush="#E0E0E0" BorderThickness="1"
                            Padding="18,14"
                            FontFamily="Iceberg, Consolas, monospace"
                            FontSize="18"
                            HorizontalContentAlignment="Center" />
                </Grid>
                <Grid Grid.Column="1" Margin="6,0,0,0">
                    <Border Background="#22000000" CornerRadius="14" Margin="2,3,0,0" />
                    <Button Content="View Elsewhere"
                            Background="White" Foreground="#111"
                            BorderBrush="#E0E0E0" BorderThickness="1"
                            Padding="18,14"
                            FontFamily="Iceberg, Consolas, monospace"
                            FontSize="18"
                            HorizontalContentAlignment="Center" />
                </Grid>
            </Grid>
        </Grid>

        <s:SceneSwitchButton Grid.ColumnSpan="2" />
    </Grid>
</Page>
