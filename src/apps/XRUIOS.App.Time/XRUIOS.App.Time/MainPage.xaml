<Page x:Class="XRUIOS.App.Time.MainPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:c="clr-namespace:XRUIOS.App.Time.Controls"
      xmlns:s="clr-namespace:XRUIOS.Apps.Shared;assembly=XRUIOS.Apps.Shared"
      Background="#F0F0F0">

    <!-- Time - Stopwatch scene. Portrait rail on the left with a "New"
         action; big Iceberg-display header + rounded search bar on the
         right; horizontal card row of active stopwatches below. -->

    <Grid Margin="20">
        <!-- COMPARE MODE: mockup overlay for 1:1 tuning. Delete when done. -->
        <Image Source="assets/mockup.png" Stretch="Uniform" Opacity="0.40" IsHitTestVisible="False" Grid.RowSpan="99" Grid.ColumnSpan="99" Canvas.ZIndex="1000" />
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="24*" />
            <ColumnDefinition Width="76*" />
        </Grid.ColumnDefinitions>

        <!-- LEFT rail -->
        <Grid Grid.Column="0" Margin="0,0,20,0">
            <Border Background="#22000000" CornerRadius="12" Margin="2,3,0,0" />
            <Border Background="White" CornerRadius="12">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*"    />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <c:PortraitPlate Grid.Row="0" />
                    <Grid Grid.Row="1" Margin="14,8,14,14">
                        <Border Background="#22000000" CornerRadius="10" Margin="2,3,0,0" />
                        <Button Content="New"
                                Background="White" Foreground="#111"
                                BorderBrush="#E0E0E0" BorderThickness="1"
                                Padding="14,14"
                                FontFamily="Iceberg, Consolas, monospace"
                                FontSize="20"
                                HorizontalContentAlignment="Center" />
                    </Grid>
                </Grid>
            </Border>
        </Grid>

        <!-- RIGHT -->
        <Grid Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*"    />
            </Grid.RowDefinitions>

            <Grid Grid.Row="0" Margin="0,4,4,20">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*"    />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0">
                    <TextBlock x:Name="ModeTitle"
                               Text="Stopwatch"
                               FontFamily="Iceberg, Consolas, monospace"
                               FontSize="38"
                               Foreground="#111" />
                    <TextBlock x:Name="ActiveCountLine"
                               Text="12 Active"
                               Foreground="#333"
                               FontSize="16"
                               FontWeight="Light"
                               Margin="0,-2,0,0" />
                </StackPanel>

                <Grid Grid.Column="1" Margin="28,10,0,10">
                    <Border Background="#22000000" CornerRadius="10" Margin="2,3,0,0" />
                    <Border Background="White"
                            BorderBrush="#E0E0E0" BorderThickness="1"
                            CornerRadius="10"
                            Padding="18,12">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*"    />
                            </Grid.ColumnDefinitions>
                            <Path Grid.Column="0" Fill="#111" Stretch="Uniform" Height="18"
                                  Data="M8,0 A8,8 0 1 1 7.9,16 A8,8 0 1 1 8,0 Z M13,13 L19,19 L21,17 L15,11 Z" />
                            <TextBox Grid.Column="1"
                                     Text="Stopwatch Name"
                                     Background="Transparent"
                                     BorderThickness="0"
                                     Foreground="#888"
                                     FontFamily="Iceberg, Consolas, monospace"
                                     FontSize="18"
                                     Margin="12,0,0,0"
                                     VerticalContentAlignment="Center" />
                        </Grid>
                    </Border>
                </Grid>
            </Grid>

            <ScrollViewer Grid.Row="1"
                          HorizontalScrollBarVisibility="Auto"
                          VerticalScrollBarVisibility="Disabled">
                <ItemsControl x:Name="Stopwatches">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <StackPanel Orientation="Horizontal" />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                </ItemsControl>
            </ScrollViewer>
        </Grid>

        <s:SceneSwitchButton Grid.ColumnSpan="2" />
    </Grid>
</Page>
