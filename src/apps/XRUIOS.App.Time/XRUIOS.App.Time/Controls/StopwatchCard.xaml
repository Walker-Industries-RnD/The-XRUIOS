<UserControl x:Class="XRUIOS.App.Time.Controls.StopwatchCard"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Width="360" Height="520" Margin="0,4,20,16">
    <!-- Vertical stopwatch card: image plate on top, footer with title/lap
         time on the bottom-left, big Iceberg "Lap N" on the bottom-right.
         Layered borders build the shadow. -->
    <Grid>
        <Border Background="#22000000" CornerRadius="12" Margin="2,3,0,0" />
        <Border Background="White" CornerRadius="12">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="*"    />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <Border Grid.Row="0" Margin="10,10,10,0" CornerRadius="8,8,0,0" ClipToBounds="True">
                    <Border.Background>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                            <GradientStop Color="#2C3844" Offset="0" />
                            <GradientStop Color="#141A22" Offset="1" />
                        </LinearGradientBrush>
                    </Border.Background>
                </Border>

                <Grid Grid.Row="1" Margin="20,14,20,20">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"    />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0">
                        <TextBlock x:Name="TitleText"   Text="" FontSize="22" FontWeight="Light" Foreground="#111" />
                        <TextBlock x:Name="LapTimeText" Text="" FontSize="13" Foreground="#555" Margin="0,2,0,0" />
                    </StackPanel>

                    <TextBlock Grid.Column="1" x:Name="LapText"
                               Text=""
                               FontFamily="Iceberg, Consolas, monospace"
                               FontSize="30"
                               Foreground="#111"
                               VerticalAlignment="Center" />
                </Grid>
            </Grid>
        </Border>
    </Grid>
</UserControl>
