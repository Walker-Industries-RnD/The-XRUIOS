<UserControl x:Class="XRUIOS.App.Calendar.Controls.EventCard"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             HorizontalContentAlignment="Stretch"
             VerticalContentAlignment="Stretch">
    <!-- One event tile in the Day view's card strip. Two columns: red
         indicator stripe + body column. The body flexes with the card
         width; selected/unselected colours are swapped in code-behind
         because there's no default XAML style system here. -->
    <Grid x:Name="Host" Background="White">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="6"  />
            <ColumnDefinition Width="*"  />
        </Grid.ColumnDefinitions>

        <Border x:Name="Stripe" Grid.Column="0" Background="#E02B2B" />

        <Grid Grid.Column="1" Margin="24,26,24,26">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*"    />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <StackPanel Grid.Row="0" Orientation="Horizontal">
                <TextBlock x:Name="IconText"  Text="&#x1F389;" FontSize="26" Margin="0,0,8,0" />
                <TextBlock x:Name="TitleText" Text="" FontSize="26" FontWeight="Light"
                           VerticalAlignment="Center" />
            </StackPanel>

            <TextBlock Grid.Row="1" x:Name="TimeText"
                       Text="" FontSize="15" FontWeight="Light"
                       Margin="0,4,0,16" />

            <TextBlock Grid.Row="2" x:Name="DescText"
                       Text="" FontSize="14" FontWeight="Light"
                       TextWrapping="Wrap" LineHeight="20" VerticalAlignment="Top" />

            <StackPanel Grid.Row="3" Margin="0,12,0,0">
                <TextBlock x:Name="ImportanceText"
                           Text="" FontSize="18" FontWeight="Light" Foreground="#E02B2B" />
                <TextBlock x:Name="RepeatsText"
                           Text="" FontSize="14" FontWeight="Light" Margin="0,2,0,0" />
            </StackPanel>
        </Grid>
    </Grid>
</UserControl>
