<UserControl x:Class="XRUIOS.App.Calendar.Controls.AgendaCard"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Margin="0,0,0,12">
    <!-- One card in the Month view's agenda column: small chip, big title,
         small time. -->
    <Border Background="White" CornerRadius="4" Padding="22,16,22,20">
        <StackPanel>
            <TextBlock x:Name="ChipText"  Text="" FontSize="14" Foreground="#555" />
            <TextBlock x:Name="TitleText" Text="" FontSize="26" FontWeight="Light" Foreground="#111" Margin="0,6,0,0" />
            <TextBlock x:Name="TimeText"  Text="" FontSize="16" Foreground="#333" Margin="0,4,0,0" />
        </StackPanel>
    </Border>
</UserControl>
