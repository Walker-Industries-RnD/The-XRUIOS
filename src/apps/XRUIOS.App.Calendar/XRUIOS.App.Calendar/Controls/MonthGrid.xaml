<UserControl x:Class="XRUIOS.App.Calendar.Controls.MonthGrid"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- 7 cols x 5 rows month grid. The row / column definitions and the
         cells are built in code because every cell has the same layout with
         only its tint colour changing - static XAML would just be 35 copies
         of the same block. If you want a proper visual template for a cell,
         extract MonthCell as its own UserControl and instantiate it here. -->
    <Grid x:Name="CellHost" />
</UserControl>
